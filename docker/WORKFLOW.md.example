---
tracker:
  kind: linear
  provider:
    project_slug: "replace-with-your-linear-project-slug"
  active_states: [Todo, In Progress]
  terminal_states: [Done, Canceled, Cancelled, Closed, Duplicate]
workspace:
  root: $SYMPHONY_WORKSPACE_ROOT
hooks:
  after_create: |
    git clone --depth 1 -- "${SOURCE_REPO_URL:?Set SOURCE_REPO_URL in .env}" .
agent:
  max_concurrent_agents: 1
codex:
  command: codex app-server
server:
  host: "0.0.0.0"
---

Work on {{ issue.identifier }} in the assigned repository.

Title: {{ issue.title }}
Description: {{ issue.description }}
